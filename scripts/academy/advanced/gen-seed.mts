/**
 * Generates two files from src/lib/academy/advanced/content:
 *  - supabase/migrations/20270303002000_academy_advanced_subjects.sql: subjects and pairings (committed).
 *  - private/academy-advanced/academy_advanced_lessons_seed.sql: the paid courses and lessons. Not committed: the
 *    repository is public, so paid lesson text stays out of it (needs the files in private/academy-advanced/lessons/).
 * Run: npx tsx scripts/academy/advanced/gen-seed.mts
 *
 * Idempotent and non-destructive, like scripts/academy/gen-seed.ts: deterministic ids (md5 of a stable key) and
 * ON CONFLICT DO NOTHING, so re-running never overwrites what an Academy admin changed in Manage. Courses are seeded
 * "in_review": AI-drafted lessons are never shown to customers until an admin reviews and publishes the course.
 */
import { writeFileSync } from "node:fs";
import path from "node:path";
import { courseCover } from "../../../src/lib/academy/content/catalog";
import { ADV_SUBJECTS, loadAdvCourses } from "../../../src/lib/academy/advanced/content";

const ADV_COURSES = await loadAdvCourses();

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "boolean") return v ? "true" : "false";
  if (typeof v === "number") return String(v);
  return `'${String(v).replace(/'/g, "''")}'`;
};
const arr = (xs: string[] | undefined) => (xs && xs.length ? `array[${xs.map(q).join(", ")}]::text[]` : "'{}'::text[]");
const json = (v: unknown) => (v === undefined || v === null ? "null" : `${q(JSON.stringify(v))}::jsonb`);
const id = (key: string) => `md5(${q(`academy:${key}`)})::uuid`;

const out: string[] = [];
out.push(`-- Generated by scripts/academy/advanced/gen-seed.mts. Do not edit by hand; edit src/lib/academy/advanced/content and regenerate.
-- Seeds ${ADV_SUBJECTS.length} Academy Advanced subjects and the default Learn + Expand pairings. Upcoming subjects are shown, never sold.
-- The paid lessons are seeded separately (academy_advanced_lessons_seed.sql, kept out of the public repository).
-- Requires 20270303001000_academy_advanced.sql. Safe to re-run: ON CONFLICT DO NOTHING; pairings only fill blanks.
`);

out.push("insert into public.academy_adv_subjects (slug, title, summary, description, outcomes, icon, cover_theme, status, sort_order) values");
out.push(ADV_SUBJECTS.map((s) => `  (${[q(s.slug), q(s.title), q(s.summary), q(s.description ?? null), arr(s.outcomes), q(s.icon), q(s.theme), q(s.status), q(s.sort)].join(", ")})`).join(",\n") + "\non conflict (slug) do nothing;\n");
out.push("-- Default Learn + Expand pairings (only filled where an admin hasn't set one).");
for (const s of ADV_SUBJECTS.filter((x) => x.next)) {
  out.push(`update public.academy_adv_subjects set recommended_next = ${q(s.next)}, recommend_reason = ${q(s.reason ?? null)} where slug = ${q(s.slug)} and recommended_next is null;`);
}
out.push("");
const subjectsFile = path.resolve(import.meta.dirname, "../../../supabase/migrations/20270303002000_academy_advanced_subjects.sql");
writeFileSync(subjectsFile, out.join("\n"));
console.log(`wrote ${subjectsFile}: ${ADV_SUBJECTS.length} subjects`);
if (!ADV_COURSES.length) { console.log("No lesson files in private/academy-advanced/lessons/: lessons seed not generated."); process.exit(0); }

out.length = 0;
out.push(`-- Generated by scripts/academy/advanced/gen-seed.mts from private/academy-advanced/lessons. NOT committed (public repository).
-- Seeds ${ADV_COURSES.length} Academy Advanced courses and their lessons as 'in_review': hidden from customers until an Academy admin publishes them.
-- Requires 20270303001000_academy_advanced.sql and 20270303002000_academy_advanced_subjects.sql. Safe to re-run: deterministic ids + ON CONFLICT DO NOTHING.
`);
const courseRows: string[] = [];
const moduleRows: string[] = [];
const lessonRows: string[] = [];
for (const { subject, course: c } of ADV_COURSES) {
  courseRows.push(`  (${[
    id(`course:${c.slug}`), q(c.slug), q(c.trade), q(c.pillar), q(c.title), q(c.summary), q(c.description), q(c.level), q(c.access), q(c.status),
    q(c.contentClass), q(courseCover(c.pillar)), q(Boolean(c.featured)), q(c.sort), arr(c.plannedLessons), q(c.seoTitle ?? null), q(c.seoDescription ?? null),
    "null", q(subject),
  ].join(", ")})`);
  const modules = [...new Set((c.lessons ?? []).map((l) => l.module))];
  modules.forEach((m, i) => moduleRows.push(`  (${id(`module:${c.slug}:${m}`)}, ${id(`course:${c.slug}`)}, ${q(m)}, ${i})`));
  (c.lessons ?? []).forEach((l, i) => {
    lessonRows.push(`  (${[
      id(`lesson:${c.slug}:${l.slug}`), id(`course:${c.slug}`), id(`module:${c.slug}:${l.module}`), q(l.slug), q(l.title), q(l.summary), q(l.body),
      arr(l.takeaways), arr(l.checklist), json(l.tradeNotes ?? {}), json(l.action ?? null), json(l.quiz ?? null), q(l.access), "'published'", q(l.minutes), q(i * 10),
    ].join(", ")})`);
  });
}
out.push("insert into public.academy_courses (id, slug, trade_slug, pillar, title, summary, description, level, access, status, content_class, cover_theme, featured, sort_order, planned_lessons, seo_title, seo_description, published_at, adv_subject) values");
out.push(courseRows.join(",\n") + "\non conflict do nothing;\n");
out.push("insert into public.academy_modules (id, course_id, title, sort_order) values");
out.push(moduleRows.join(",\n") + "\non conflict do nothing;\n");
out.push("insert into public.academy_lessons (id, course_id, module_id, slug, title, summary, body_md, takeaways, checklist, trade_notes, app_action, quiz, access, status, estimated_minutes, sort_order) values");
out.push(lessonRows.join(",\n") + "\non conflict do nothing;\n");

const file = path.resolve(import.meta.dirname, "../../../private/academy-advanced/academy_advanced_lessons_seed.sql");
writeFileSync(file, out.join("\n"));
console.log(`wrote ${file}: ${courseRows.length} courses, ${lessonRows.length} lessons`);
