# Copy to .env.local for local development. In Netlify, set these under Site settings > Environment variables.
# NEXT_PUBLIC_* values are sent to the browser. Everything else must stay server-side.

# --- Brand (rebrand without code changes) ---
NEXT_PUBLIC_SITE_NAME=Bid2Build
NEXT_PUBLIC_SITE_DOMAIN=localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Leave unset/false until public launch is approved; robots.txt then disallows everything.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Stripe (test mode: keys start with sk_test_ / whsec_) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs created by `npm run stripe:setup` (or in the Stripe dashboard)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Live keys are refused unless this is "true". Only set after the owner approves live payments.
STRIPE_ALLOW_LIVE=false
