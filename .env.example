# Copy to .env.local for local development. In Netlify, set these under Site settings > Environment variables.
# NEXT_PUBLIC_* values are sent to the browser. Everything else must stay server-side.

# Full list with purposes and per-context guidance: docs/launch/ENVIRONMENT_VARIABLE_INVENTORY.md

# --- Brand & URLs (domain moves are env changes, not code changes) ---
NEXT_PUBLIC_SITE_NAME=Built2Bid
# Canonical public URL. On Netlify set it for the PRODUCTION context only (e.g. https://built2bid.org once
# the domain is live). Deploy previews and branch deploys ignore it and use their own DEPLOY_PRIME_URL.
# Unset in production = Netlify's primary URL. Unset locally = http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional display domain; defaults to the host of the site URL.
NEXT_PUBLIC_SITE_DOMAIN=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Search indexing. Only takes effect on a Netlify PRODUCTION deploy; previews are always noindex.
# Leave false until public launch is approved; robots.txt then disallows everything.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Google Maps address autocomplete (optional) ---
# Browser key restricted by HTTP referrer to your domains, with "Places API (New)" and
# "Maps JavaScript API" enabled. Empty = address fields are plain text inputs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Limit suggestions to these ISO country codes (comma-separated). Default us. Empty value = worldwide.
NEXT_PUBLIC_GOOGLE_MAPS_REGIONS=us

# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Stripe (test mode: keys start with sk_test_ / whsec_) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs created by `npm run stripe:setup` (or in the Stripe dashboard)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Live keys are refused unless this is "true". Only set after the owner approves live payments.
STRIPE_ALLOW_LIVE=false

# --- AI writing for Scope of Work / Exclusions (optional) ---
# SERVER ONLY. Without a key, contractors get drafts from built-in rules (no AI, no cost).
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 (~2 cents per draft). claude-haiku-5-5 is ~40x cheaper.
AI_MODEL=
# Per-user daily cap and a hard monthly spend ceiling across all users (USD).
AI_DAILY_LIMIT_PER_USER=40
AI_MONTHLY_BUDGET_USD=25
# Set to "off" to disable AI writing without removing the key.
AI_TEXT_GENERATION=

# --- Instantly outreach sync (INCOMPLETE: untested until an Instantly workspace exists) ---
# SERVER ONLY. API v2 key with scopes leads:create and block_list_entries:create.
INSTANTLY_API_KEY=
# Must be "true" for the app to call Instantly at all (block-listing customers and opt-outs).
INSTANTLY_SYNC_ENABLED=false
# SERVER ONLY. Long random string. Add it to each Instantly webhook as header x-built2bid-webhook-secret.
INSTANTLY_WEBHOOK_SECRET=

# SMS sign-in (off until Twilio Verify is set up in Supabase; see docs/auth/SMS_SIGN_IN.md)
NEXT_PUBLIC_SMS_SIGNIN=
# Cloudflare Turnstile site key for code requests (secret goes in Supabase, not here)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
